# Copy to .env and edit. Every value is optional.
PORT=5000
# 127.0.0.1 = only this computer. Use 0.0.0.0 to open it to your Wi-Fi (then set ACCESS_PIN).
HOST=127.0.0.1
MONGODB_URI=mongodb://127.0.0.1:27017/netpayload
# If set, the browser must enter this PIN before using the API.
ACCESS_PIN=
# Extra hostnames the server may be reached by (comma separated), e.g. my-mac.local. IP addresses and localhost always work.
ALLOWED_HOSTS=
# By default only private LAN addresses (10.x, 172.16-31.x, 192.168.x, fc00::/7, fe80::/10) can be targeted.
ALLOW_PUBLIC_TARGETS=false
ALLOW_LOOPBACK_TARGETS=false
# Size limits in bytes
MAX_TCP_BYTES=1073741824
MAX_UDP_BYTES=8388608
